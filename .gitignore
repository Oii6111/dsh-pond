# 这个插件包自己的 git 仓库 —— 只装插件本体，别装用户数据
node_modules/
.venv/
*.log
*.bak*
data/
credential*.json
seen_bvids.json
out/
log/

# 给你本机双击用的脚本（里面有本机绝对路径），不进仓库
*.cmd

# 跑 tools/check-vision.py 会生成
__pycache__/
*.pyc
style-probe-*/

# 发版时把 npm 缓存指到工作区里（沙箱 / 无写权限的 %LOCALAPPDATA% 下也能 publish）
.npm-cache/

# npm pack 的产物（发 Release 时临时用）
*.tgz

